APP_ENV=development
APP_URL=http://localhost/document-request-system/backend/public

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=document_request_system
DB_USER=root
DB_PASS=

# ── JWT ─────────────────────────────────────────────────────
# Generate with: php -r "echo bin2hex(random_bytes(48));"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRY=86400

# ── Frontend URL (CORS + email links) ───────────────────────
FRONTEND_URL=http://localhost:5173,https://acadoqs-web-drtn.vercel.app

# PayMongo hosted checkout
# Use test keys while developing. Keep the secret key on the backend only.
PAYMONGO_PUBLIC_KEY=pk_test_your_paymongo_public_key
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key

# ── File uploads ────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=../storage/uploads

# ── Seed / admin credentials (used by seed script only) ─────
ADMIN_EMAIL=admin@school.edu
ADMIN_PASSWORD=Admin@1234

# ── SMTP (leave MAIL_HOST empty to disable email) ───────────
# Gmail: enable 2FA → generate App Password at myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your@gmail.com
MAIL_FROM_NAME=AcaDocs Registrar

# ── SMS — PhilSMS (https://philsms.com) ─────────────────────
# Leave SMS_API_KEY empty to disable SMS notifications
SMS_API_KEY=your_philsms_api_key_here
SMS_SENDER_ID=PhilSMS

# Cron security token (used for /api/cron/send-release-reminders)
CRON_SECRET=change_me_to_a_long_random_token
